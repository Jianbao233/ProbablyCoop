<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net9.0</TargetFramework><OutputType>Exe</OutputType><LangVersion>latest</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutDir>bin\$(Configuration)\</OutDir></PropertyGroup>
  <ItemGroup>
    <Reference Remove="@(Reference)" />
    <Compile Include="Logic.cs" />
    <Compile Include="NativeMetadata.cs" />
    <Compile Include="..\..\..\Game\NativeActorCarryUi.cs" Link="Game\NativeActorCarryUi.cs" />
  </ItemGroup>
  <Target Name="RejectInheritedGameReferences" BeforeTargets="PrepareForBuild"><Error Condition="'@(Reference)' != ''" Text="CarryUiLogic uses explicit doubles, never game or Harmony references." /></Target>
  <Target Name="RecordNativeReferencePath" AfterTargets="Build"><WriteLinesToFile File="$(OutDir)native-managed-path.txt" Lines="$(GameManaged)" Overwrite="true" /></Target>
</Project>
